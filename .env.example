# express
export PORT=4000
export HOST=localhost
# DB
export DMD_DB_POSTGRES="postgres"
export DMD_DB_POSTGRES_PASS="change-me-to-a-strong-password"
export DMD_DB_POSTGRES_PORT=5433
export DMD_DB_POSTGRES_HOST=127.0.0.1
export DMD_PGADMIN_PASS="change-me-to-a-strong-password"
export DMD_DB_API_PASS="change-me-to-a-strong-password"

export POSTGRES_INSTANCE=127.0.0.1:5433
export RPC_URL="http://localhost:54100/"
export RPC_URL_DOCKER=http://host.docker.internal:54100/
export DEV_TOOLS_LOG_DEBUG=false

export DMD_REGISTRAR_CONTROLLER_ADDRESS=""
export DMD_NAMES_ADDRESS=""
export DMD_RESOLVER_ADDRESS=""

# DNS
export DNS_SYNC_START_BLOCK=
export DNS_SYNC_CONFIRMATIONS=0
export DNS_SYNC_REORG_DEPTH=50
export DNS_SYNC_CHUNK_SIZE=2000
export DNS_SYNC_POLL_INTERVAL_MS=5000
export DNS_SYNC_RECONCILE_INTERVAL_MS=900000
export DNS_SYNC_MAX_ATTEMPTS=10
export DNS_SYNC_RETRY_BASE_MS=5000
export DNS_SYNC_RETRY_MAX_MS=900000
export DNS_SYNC_RPC_TIMEOUT_MS=30000
export DNS_SYNC_HANDLER=logging

# Plesk
export DNS_SYNC_PLESK_URL=""
export DNS_SYNC_PLESK_API_KEY=""
export DNS_SYNC_PLESK_ZONE=""
